# Next.js rewrites proxy API requests to the backend (same origin, no CORS in dev).
# On macOS, AirPlay Receiver may occupy port 5000 — use 5001 if you see 403 errors.
BACKEND_URL=http://localhost:8000

# Leave unset in local dev so axios uses same-origin paths via rewrites above.
# Set only for production or when calling the API directly from the browser.
# NEXT_PUBLIC_API_BASE_URL=
