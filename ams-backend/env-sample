# .env - stores secrets and config values, never commit this file to GitHub

# Neon connection string - get this from: Neon Console -> Connect button
DATABASE_URL=postgresql://neondb_owner:npg_ov8NjDh7usGe@ep-square-boat-ao8j82im-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Port the Express server runs on - defaults to 5000 if not set.
# On macOS, AirPlay Receiver may occupy port 5000 — use 5001 if the server cannot bind.
PORT=5000

# Base64url-encoded 32-byte key used for authenticated JWT encryption.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ENCRYPTION_KEY=replace_with_generated_key
ACCESS_TOKEN_EXPIRES_IN=15m
JWT_ISSUER=ams-backend
JWT_AUDIENCE=ams-frontend

# Rotating refresh sessions. The refresh token is kept in an HttpOnly cookie.
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=ams_refresh
REFRESH_TOKEN_PEPPER=replace_with_another_long_random_secret
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000